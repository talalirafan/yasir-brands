MONGODB_URI=mongodb://localhost:27017/ysr-fragrances
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=7d
PORT=3000

# Order / contact notification settings
ADMIN_EMAIL=you@example.com
ADMIN_WHATSAPP=
CALLMEBOT_API_KEY=

# Preferred email sender — sign up free at resend.com, copy your API key.
# Without a verified domain on Resend, emails can only be delivered to the
# address you signed up with (fine for ADMIN_EMAIL notifications; customer
# confirmation emails to other addresses need a verified domain).
RESEND_API_KEY=
RESEND_FROM=Yasir Fragrances <onboarding@resend.dev>

# Fallback sender if RESEND_API_KEY is not set (unreliable at any real volume)
GMAIL_USER=
GMAIL_APP_PASSWORD=
